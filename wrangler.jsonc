// Front de RutApp en Cloudflare Workers (solo archivos estáticos, sin código de servidor).
// El build (npm run build) deja todo en dist/; las rutas de la SPA caen en index.html.
{
  "name": "rutapps",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
